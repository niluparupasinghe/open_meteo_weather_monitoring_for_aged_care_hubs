# ==============================================================================
# 1. ENVIRONMENT, LOGGING & REPAIR CONFIGURATION
# ==============================================================================
APP_ENV=local
LOG_LEVEL=INFO
LOG_DIR=./logs
PIPELINE_STEP_AUDIT_FILE=./logs/pipeline_steps_audit.jsonl
PIPELINE_NAME=loopiq_open_meteo_lakehouse

# ==============================================================================
# 2. OPEN-METEO API CONFIGURATION & RATE LIMIT GOVERNANCE
# ==============================================================================
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=
API_TIMEOUT_SECONDS=30
API_MAX_RETRIES=5
API_RETRY_BACKOFF_FACTOR=1.5
API_MAX_LOCATIONS_PER_BATCH=50
API_RATE_LIMIT_PER_MINUTE=600.0
API_RATE_LIMIT_PER_HOUR=5000.0
API_RATE_LIMIT_PER_DAY=10000.0
API_SAFETY_BUFFER_RATIO=0.85
API_USE_OFFLINE_CACHE=false

# ==============================================================================
# 3. WEATHER DOMAIN PARAMETERS (15-MINUTE, HOURLY & DAILY)
# ==============================================================================
WEATHER_PAST_DAYS=7
WEATHER_FORECAST_DAYS=7
WEATHER_TEMPERATURE_UNIT=celsius
WEATHER_WIND_SPEED_UNIT=kmh
WEATHER_PRECIPITATION_UNIT=mm
WEATHER_CELL_SELECTION=land
WEATHER_MINUTELY_15_VARS=temperature_2m,precipitation,wind_speed_10m,weather_code
WEATHER_HOURLY_VARS=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation_probability,precipitation,weather_code,surface_pressure,wind_speed_10m,uv_index
WEATHER_DAILY_VARS=weather_code,temperature_2m_max,temperature_2m_min,apparent_temperature_max,apparent_temperature_min,precipitation_sum,uv_index_max,wind_speed_10m_max
LOCATIONS_CONFIG_PATH=config/locations.json

# ==============================================================================
# 4. LANDING ZONE, LAKEHOUSE STORAGE & SPARK / DELTA CONFIGURATION
# ==============================================================================
DATA_ROOT_DIR=./data
LANDING_RAW_JSON_DIR=./data/landing/raw_json
OPS_PATH=./data/lakehouse/ops
BRONZE_PATH=./data/lakehouse/bronze
SILVER_PATH=./data/lakehouse/silver
GOLD_PATH=./data/lakehouse/gold
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
DELTA_ENABLE_CDF=true

# ==============================================================================
# 5. DATA QUALITY, ARCHIVING & GOLD ALERTING THRESHOLDS
# ==============================================================================
DQ_MIN_VALID_TEMP_C=-50.0
DQ_MAX_VALID_TEMP_C=60.0
DQ_MAX_VALID_PRECIP_MM=1000.0
DQ_MAX_VALID_WIND_KMH=400.0
DQ_MIN_SURFACE_PRESSURE_HPA=850.0
DQ_MAX_SURFACE_PRESSURE_HPA=1100.0
DQ_MAX_VALID_UV_INDEX=25.0
ALERT_HEATWAVE_TEMP_C=35.0
ALERT_COLD_SNAP_TEMP_C=5.0
ALERT_HIGH_WIND_KMH=60.0
ALERT_HIGH_UV_INDEX=8.0
ARCHIVE_HOT_RETENTION_DAYS=30
ARCHIVE_WARM_RETENTION_DAYS=90
ARCHIVE_COLD_EXPIRATION_DAYS=2555

# ==============================================================================
# 6. PIPELINE RUN EMAIL NOTIFICATION CONFIGURATION (SUCCESS & FAILURE)
# ==============================================================================
ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
